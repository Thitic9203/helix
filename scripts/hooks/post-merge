#!/bin/bash
# Rename Claude plugin cache symlink when version changes after git pull

PLUGIN_JSON=".claude-plugin/plugin.json"
MARKETPLACE_NAME="helix-dev"
PLUGIN_NAME="helix"
CACHE_BASE="$HOME/.claude/plugins/cache/$MARKETPLACE_NAME/$PLUGIN_NAME"

[ -d "$CACHE_BASE" ] || exit 0

if [ -f VERSION ]; then
  VERSION="$(tr -d '[:space:]' < VERSION)"
else
  VERSION=$(grep '"version"' "$PLUGIN_JSON" | head -1 | sed 's/.*"\([0-9]*\.[0-9]*\.[0-9]*\)".*/\1/')
fi
[ -z "$VERSION" ] && exit 0
[ -L "$CACHE_BASE/$VERSION" ] && exit 0

# Rename the DEV SYMLINK only, and glob WITHOUT a trailing slash:
#   - "$CACHE_BASE"/*/ expands a symlink-to-dir with a trailing slash, and `mv symlink/ dest`
#     follows the link — that moved the whole helix working repo into the plugin cache
#     instead of renaming the link (hit on the 1.5.73 -> 1.5.77 pull).
#   - `claude plugin update` can leave a real copy of an older version beside the symlink;
#     renaming that copy would strand the symlink. -L skips it.
for OLD_ENTRY in "$CACHE_BASE"/*; do
  [ -L "$OLD_ENTRY" ] || continue
  OLD_VER=$(basename "$OLD_ENTRY")
  if [ "$OLD_VER" != "$VERSION" ]; then
    mv "$OLD_ENTRY" "$CACHE_BASE/$VERSION"
    echo "Cache symlink renamed: $OLD_VER -> $VERSION"
    break
  fi
done

# Sync Claude marketplace plugin (helix@helix-dev; retire helix@local)
if [ -x "scripts/claude-plugin-sync.sh" ]; then
  HELIX_QUIET=1 bash scripts/claude-plugin-sync.sh \
    || echo "post-merge: claude-plugin-sync.sh failed (exit $?) — run it by hand: bash scripts/claude-plugin-sync.sh" >&2
fi
