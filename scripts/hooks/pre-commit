#!/bin/bash
# helix pre-commit — guard + auto version-bump. Runs on the STAGED content (what is
# actually being committed), not the dirty working tree.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
VERSION_FILE="$ROOT/VERSION"

STAGED="$(git diff --cached --name-only)"

# --- HARD guard: block any OLS/customer secret from entering helix ---
# Materialize the STAGED blobs into a temp tree (paths mirrored) and scan THAT, so a
# secret staged-but-then-removed-from-working-tree cannot slip through, and vice-versa.
STAGED_ACM="$(git diff --cached --name-only --diff-filter=ACM)"
if [ -n "$STAGED_ACM" ]; then
  TMP="$(mktemp -d)"
  trap 'rm -rf "$TMP"' EXIT
  FILES=()
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    mkdir -p "$TMP/$(dirname "$f")"
    git show ":$f" > "$TMP/$f" 2>/dev/null || continue
    FILES+=("$f")
  done <<< "$STAGED_ACM"
  if [ "${#FILES[@]}" -gt 0 ]; then
    SCAN_ROOT="$TMP" "$ROOT/scripts/check-no-secrets.sh" "${FILES[@]}"
  fi
fi

version_staged=false
echo "$STAGED" | grep -qx 'VERSION' && version_staged=true

# Deploy contract: ANY change that affects the plugin — skill-tree markdown (SKILL.md flat,
# WORKFLOW.md + references nested under skills/procedures/<name>/**), commands, top-level
# references, OR the tooling/CI itself (scripts/**, .github/workflows/**) — ships a new
# version. Broad on purpose: never require a manual bump/release for an infra change.
# (VERSION/manifests are the bump artifacts and are guarded by version_staged, not here.)
BUMP_PATTERN='^(skills/.*\.md|commands/[^/]+\.md|references/[^/]+\.md|scripts/.*|\.github/workflows/.*)$'

needs_bump=false
if echo "$STAGED" | grep -qE "$BUMP_PATTERN"; then
  needs_bump=true
fi

if [ "$needs_bump" = true ] && [ "$version_staged" = false ]; then
  echo "pre-commit: workflow files changed — bumping patch version"
  "$ROOT/scripts/bump-version.sh" patch
  git add VERSION .claude-plugin/plugin.json .claude-plugin/marketplace.json README.md
fi

"$ROOT/scripts/sync-version.sh" --check
